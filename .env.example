# See README for what each of these does.

# Fine-grained GitHub PAT: Issues read+write on the inbox repo,
# Contents read+write on the site repo. Without it the suggestion form
# falls back to a prefilled mailto link.
GITHUB_TOKEN=

# The secret in Lucy's review link: https://<site>/review/<REVIEW_KEY>
REVIEW_KEY=

# Optional — turns on the "new suggestion" email.
RESEND_API_KEY=
SUGGESTIONS_TO=lucy.aitchison3@gmail.com
SUGGESTIONS_FROM="ENDO guide <onboarding@resend.dev>"

# Optional overrides.
# INBOX_REPO=sophieandawaffle/endo-suggestions-inbox
# SITE_REPO=sophieandawaffle/endometriosis-resource-guide
# SITE_BRANCH=main
